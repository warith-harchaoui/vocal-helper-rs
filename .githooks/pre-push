#!/usr/bin/env bash
#
# Pre-push gate: nothing red leaves this machine.
#
# Enabled per clone by scripts/install-hooks.sh, which points this repo's
# core.hooksPath here. That is deliberate: a global core.hooksPath (git-lfs
# installs one) silently overrides .git/hooks, so a hook dropped there is never
# run. The git-lfs delegations below replicate what the global hooks did, so
# redirecting hooksPath doesn't cost this repo its LFS support.
set -euo pipefail

echo "pre-push: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-push: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-push: cargo test --all"
cargo test --all

# The `onnx` feature is the binding that drives the graphs, and nothing above
# compiles it. Kept out of CI (it downloads a prebuilt ONNX Runtime), so this is
# the one place it is gated.
echo "pre-push: cargo clippy --all-targets --features onnx -- -D warnings"
cargo clippy --all-targets --features onnx -- -D warnings

# The accelerator features need a prebuilt ONNX Runtime per platform, so each
# is gated where it can be built: `cuda` and `tensorrt` in CI (Ubuntu, CPU
# fallback, no GPU), `coreml` here on a Mac, including the test that registers
# CoreML for real.
if [ "$(uname -s)" = "Darwin" ]; then
  echo "pre-push: cargo clippy --all-targets --features coreml -- -D warnings"
  cargo clippy --all-targets --features coreml -- -D warnings
  echo "pre-push: cargo test --features coreml --test onnx_accel"
  cargo test --features coreml --test onnx_accel
fi

# The three checks above build against the committed Cargo.lock and therefore
# cannot see a dependency range that has gone bad for everyone downstream.
echo "pre-push: fresh resolve (no Cargo.lock)"
"$(git rev-parse --show-toplevel)/scripts/check-fresh-resolve.sh"

echo "pre-push: OK"

# Run last: on a rejected push there is no point uploading LFS objects first.
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
fi
